    "US_EQ": "https://spec.edmcouncil.org/fibo/ontology/SEC/Equities/EquityInstruments/CommonStock",
    "US_PREFERRED": "https://spec.edmcouncil.org/fibo/ontology/SEC/Equities/EquityInstruments/PreferredStock",
    "US_ETF": "https://spec.edmcouncil.org/fibo/ontology/SEC/Funds/PooledInvestmentFunds/ExchangeTradedFund",
    "US_OPTION": "https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/OptionsContracts/OptionContract",
    "REAL_ESTATE": null
  },
  "identifier_scheme_to_fibo_iri": {
