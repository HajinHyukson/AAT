    "cik": "https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/RegistrationAuthorities/SecCikIdentifier",
    "figi": "https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/FinancialInstrumentIdentifier",
    "isin": "https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/IdentifiersAndIndicators/ISIN",
    "cusip": "https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/IdentifiersAndIndicators/CUSIP",
    "sedol": "https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/IdentifiersAndIndicators/SEDOL",
