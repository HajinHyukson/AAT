  "missing_module_behavior": {
    "default_node_behavior": "open_locked_preserve_config",
    "default_connector_behavior": "fail_closed",
    "default_profile_behavior": "block_profile_use",
    "notes": "Missing optional modules (AAT) degrade gracefully via open_locked_preserve_config on dependent nodes. Missing hard dependencies block module load. Missing licensed connectors fail closed (query_policy=blocked); dependent nodes open as locked placeholders and dependent profiles block_profile_use. No silent fallback to bad data."
  },
